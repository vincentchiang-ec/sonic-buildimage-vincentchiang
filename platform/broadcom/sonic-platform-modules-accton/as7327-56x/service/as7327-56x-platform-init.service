[Unit]
Description=Accton AS7327-56X Platform initialization service
Before=pmon.service determine-reboot-cause.service system-health.service
After=sysinit.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/accton_as7327_56x_util.py install
ExecStop=/usr/local/bin/accton_as7327_56x_util.py clean

# Resource Limitations
LimitCORE=infinity

[Install]
WantedBy=multi-user.target
