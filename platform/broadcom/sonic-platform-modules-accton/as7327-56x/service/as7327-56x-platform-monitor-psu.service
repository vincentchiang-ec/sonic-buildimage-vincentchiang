[Unit]
Description=Accton AS7327-56X Platform Monitoring PSU service
Before=pmon.service
After=as7327-56x-platform-init.service
Requires=as7327-56x-platform-init.service
DefaultDependencies=no

[Service]
ExecStart=/usr/local/bin/accton_as7327_56x_monitor_psu.py

# Resource Limitations
LimitCORE=infinity

[Install]
WantedBy=multi-user.target
